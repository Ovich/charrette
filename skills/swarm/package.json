    "@vitejs/plugin-react": "6.1.0",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
