# dependencies (aiview)
node_modules/

# aiview build output is COMMITTED, not ignored: a plugin update lands as a fresh
# copy under ~/.claude/plugins/cache/, so anything not in git means every user
# re-runs a 347 MB npm install to rebuild it. See RELEASING.md.

# Per-machine state now lives in the data home (~/charrette_appdata), not here.
# These are only left by pre-appdata installs; ignored so an old checkout stays clean.
skills/aiview/aiview.sqlite
skills/aiview/aiview.pid
skills/aiview/aiview.port

# Playwright MCP scratch output (screenshots, console logs).
.playwright-mcp/
