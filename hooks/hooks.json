{
  "description": "swarm: every board member receives the messages for it, after each tool call and before it stops (swarm-relay D43). A session that is no member costs one file check.",
  "hooks": {
    "PostToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/companions/swarm-board/dist-cli/hook.mjs\"", "timeout": 20 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/companions/swarm-board/dist-cli/hook.mjs\"", "timeout": 20 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/companions/swarm-board/dist-cli/hook.mjs\"", "timeout": 20 }] }
    ]
  }
}
